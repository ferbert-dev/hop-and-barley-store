{
  "name": "hop-and-barley-store",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@hop-and-barley/web",
    "dev:api": "pnpm --filter @hop-and-barley/api dev",
    "local:up": "docker compose up -d --build --wait",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f web api postgres",
    "build": "turbo run build",
    "clean": "pnpm clean:artifacts",
    "clean:artifacts": "node scripts/clean-workspace-artifacts.mjs",
    "lint": "pnpm db:generate && turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generated:verify": "pnpm --filter @hop-and-barley/auth-contract build && node scripts/verify-generated-stability.mjs",
    "ci:contract": "node --test scripts/ci-workflow-contract.test.mjs scripts/configure-ci-browser-env.test.mjs",
    "secret-hooks:check": "node --test scripts/secret-hooks.test.mjs",
    "workflow:check": "node --test scripts/engineering-workflow-contract.test.mjs scripts/ci-workflow-contract.test.mjs",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:catalog:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:catalog:postgres",
    "test:a1:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:a1:postgres",
    "test:a1b:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:a1b:postgres",
    "test:m1:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:m1:postgres",
    "test:m2:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:m2:postgres",
    "test:o0:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:o0:postgres",
    "test:o1b:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:o1b:postgres",
    "test:o2:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:o2:postgres",
    "test:o2q:postgres": "pnpm --filter @hop-and-barley/auth-contract build && pnpm --filter @hop-and-barley/api test:o2q:postgres",
    "test:a1:argon2:alpine": "pnpm --filter @hop-and-barley/api test:a1:argon2:alpine",
    "test:a1b:argon2:alpine": "pnpm --filter @hop-and-barley/api test:a1b:argon2:alpine",
    "db:generate": "pnpm --filter @hop-and-barley/api db:generate",
    "db:migrate:dev": "pnpm --filter @hop-and-barley/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @hop-and-barley/api db:migrate:deploy",
    "db:seed": "pnpm --filter @hop-and-barley/api db:seed",
    "api:generate": "pnpm --filter @hop-and-barley/api generate:openapi && pnpm --filter @hop-and-barley/api-client generate",
    "admin:provision:local": "pnpm --filter @hop-and-barley/api admin:provision:local",
    "check": "pnpm workflow:check && pnpm secret-hooks:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "check:full": "pnpm check && pnpm test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "turbo": "2.10.9"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yaml,yml,css}": "prettier --write"
  }
}
