# -----------------------------------------------------------------------------
# General / Compose
# -----------------------------------------------------------------------------
# Safe local defaults. Copy this file to .env and replace every placeholder.
COMPOSE_PROJECT_NAME=hop-and-barley
NODE_ENV=production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17.6-alpine
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=hopbarley
POSTGRES_USER=hopbarley
# Required credential. Use a local-only value; do not commit it.
POSTGRES_PASSWORD=replace-with-local-only-password
# Host-side Prisma URL and container-side API/migration URL.
DATABASE_URL=postgresql://hopbarley:replace-with-local-only-password@localhost:5432/hopbarley?schema=public
API_DATABASE_URL=postgresql://hopbarley:replace-with-local-only-password@postgres:5432/hopbarley?schema=public

# -----------------------------------------------------------------------------
# Backend / API, origins, cookies, and secrets
# -----------------------------------------------------------------------------
API_HOST_BIND=127.0.0.1
API_PORT=3001
# Server-only runtime storage. Compose mounts its named volume here; do not
# point this at tracked source or place credentials in the value.
PRODUCT_ASSET_STORAGE_PATH=/var/lib/hop-and-barley/product-assets
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTH_COOKIE_MODE=local-http
AUTH_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
AUTH_SESSIONS_ENABLED=false
# Required when auth sessions are enabled. Replace with version:64-lowercase-hex.
AUTH_CSRF_KEYRING=replace-with-version-and-64-lowercase-hex

CART_COOKIE_MODE=local-http
CART_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Required. Replace with version:64-lowercase-hex.
CART_CSRF_KEYRING=replace-with-version-and-64-lowercase-hex

REGISTRATION_ENABLED=true
REGISTRATION_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Frontend / public configuration
# -----------------------------------------------------------------------------
WEB_HOST_BIND=127.0.0.1
WEB_HOSTNAME=0.0.0.0
WEB_PORT=3000
# Server-only URL used by Next.js inside Compose.
API_INTERNAL_URL=http://api:3001/api/v1
# Browser-visible canonical loopback URL. Client code preserves the current
# localhost or 127.0.0.1 hostname. Never place credentials or secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public allow-list for equivalent local API/browser hostnames.
NEXT_PUBLIC_API_HOST_ALIASES=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# None configured. Keep any future secret backend-only and without NEXT_PUBLIC_.
