generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String
  priceMinor  Int
  currency    String   @default("EUR") @db.VarChar(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}
