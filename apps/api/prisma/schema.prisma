generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CartReservationStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONSUMED
}

enum OrderStatus {
  PLACED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  STRIPE_DEBIT_CARD
  CASH_ON_DELIVERY
}

enum PaymentState {
  PENDING
  PAID
  DUE_ON_DELIVERY
  FAILED
  CANCELLED
}

enum CheckoutDraftStatus {
  PRE_PAYMENT
}

enum DiscountClaimStatus {
  CLAIMED
  CONSUMED
  RELEASED
}

enum DiscountClaimReleaseReason {
  DEFINITIVE_PAYMENT_FAILED
  DEFINITIVE_PAYMENT_CANCELLED_UNPAID
}

enum DiscountKind {
  NONE
  FIRST_PURCHASE
}

enum PaymentAttemptStatus {
  PREPARED
  PENDING
  RECONCILIATION_REQUIRED
  SUCCEEDED
  DEFINITIVELY_FAILED
  CANCELLED
}

enum PaymentAllocationStatus {
  ALLOCATED
  CAPTURE_REQUESTED
  RECONCILIATION_REQUIRED
  CAPTURED
  RELEASED
}

enum PaymentAllocationReleaseReason {
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  AUTHORIZATION_EXPIRED
  STOCK_UNAVAILABLE
}

enum StripeWebhookDisposition {
  PROCESSED
  IGNORED
}

enum SaleKind {
  WEIGHT
  PACKAGE
  KIT
}

enum AmountUnit {
  MILLIGRAM
  EACH
}

model User {
  id                 String                       @id(map: "User_pkey") @default(uuid()) @db.Uuid
  email              String                       @db.VarChar(320)
  normalizedEmail    String                       @unique(map: "User_normalizedEmail_key") @db.VarChar(320)
  role               UserRole                     @default(CUSTOMER)
  status             UserStatus                   @default(ACTIVE)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  passwordCredential PasswordCredential?
  authSessions       AuthSession[]
  customerProfile    CustomerProfile?
  primaryAddress     PrimaryAddress?
  orders             Order[]
  cart               Cart?
  checkoutDrafts     CheckoutDraft[]
  paymentAttempts    PaymentAttempt[]
  discountClaims     FirstPurchaseDiscountClaim[]
}

model CustomerProfile {
  userId            String    @id(map: "CustomerProfile_pkey") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CustomerProfile_userId_fkey")
  fullName          String?   @db.VarChar(200)
  phone             String?   @db.VarChar(32)
  avatarData        Bytes?
  avatarContentType String?   @db.VarChar(32)
  avatarSizeBytes   Int?
  avatarUpdatedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PrimaryAddress {
  userId         String   @id(map: "PrimaryAddress_pkey") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PrimaryAddress_userId_fkey")
  country        String?  @db.VarChar(120)
  city           String?  @db.VarChar(120)
  postalCode     String?  @db.VarChar(32)
  street         String?  @db.VarChar(200)
  houseNumber    String?  @db.VarChar(32)
  apartmentUnit  String?  @db.VarChar(64)
  floor          String?  @db.VarChar(32)
  additionalInfo String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PasswordCredential {
  userId       String   @id(map: "PasswordCredential_pkey") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PasswordCredential_userId_fkey")
  passwordHash String   @db.VarChar(255)
  algorithm    String   @db.VarChar(16)
  version      Int      @db.SmallInt
  memoryCost   Int
  timeCost     Int      @db.SmallInt
  parallelism  Int      @db.SmallInt
  hashLength   Int      @db.SmallInt
  saltLength   Int      @db.SmallInt
  changedAt    DateTime @default(now())
}

model AuthSession {
  id                         String    @id(map: "AuthSession_pkey") @default(uuid()) @db.Uuid
  tokenHash                  Bytes     @unique(map: "AuthSession_tokenHash_key")
  userId                     String    @db.Uuid
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AuthSession_userId_fkey")
  roleAtIssue                UserRole
  credentialChangedAtAtIssue DateTime
  issuedAt                   DateTime  @default(now())
  lastSeenAt                 DateTime
  expiresAt                  DateTime
  revokedAt                  DateTime?

  @@index([userId, revokedAt, expiresAt, lastSeenAt], map: "AuthSession_userId_active_idx")
  @@index([expiresAt], map: "AuthSession_expiresAt_idx")
}

model Category {
  id           String    @id(map: "Category_pkey") @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique(map: "Category_slug_key")
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([displayOrder, name], map: "Category_displayOrder_name_idx")
}

model Product {
  id                  String                   @id(map: "Product_pkey") @default(uuid()) @db.Uuid
  name                String
  slug                String                   @unique(map: "Product_slug_key")
  teaser              String
  description         String
  priceMinor          Int
  priceQualifier      String                   @db.VarChar(64)
  currency            String                   @default("EUR") @db.VarChar(3)
  saleKind            SaleKind
  amountUnit          AmountUnit
  priceBasisAmount    Int
  minimumOrderAmount  Int
  orderStepAmount     Int
  maximumOrderAmount  Int?
  stockAmount         Int                      @default(0)
  packageNetWeightMg  Int?
  kitYieldVolumeMl    Int?
  isActive            Boolean                  @default(true)
  activeFrom          DateTime?                @db.Timestamptz(3)
  activeUntil         DateTime?                @db.Timestamptz(3)
  imagePath           String                   @db.VarChar(255)
  searchDocument      Unsupported("tsvector")?
  specifications      Json                     @db.JsonB
  categoryId          String                   @db.Uuid
  category            Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Product_categoryId_fkey")
  cartItems           CartItem[]
  cartReservations    CartReservation[]
  orderItems          OrderItem[]
  paymentAttemptItems PaymentAttemptItem[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([categoryId, isActive], map: "Product_categoryId_isActive_idx")
  @@index([isActive, priceMinor], map: "Product_isActive_priceMinor_idx")
  @@index([name], map: "Product_name_idx")
}

model Cart {
  id            String            @id(map: "Cart_pkey") @default(uuid()) @db.Uuid
  tokenDigest   Bytes             @unique(map: "Cart_tokenDigest_key")
  userId        String?           @unique(map: "Cart_userId_key") @db.Uuid
  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Cart_userId_fkey")
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         CartItem[]
  reservations  CartReservation[]
  orders        Order[]
  checkoutDraft CheckoutDraft?

  @@index([expiresAt], map: "Cart_expiresAt_idx")
}

model CartItem {
  id                   String            @id(map: "CartItem_pkey") @default(uuid()) @db.Uuid
  cartId               String            @db.Uuid
  productId            String            @db.Uuid
  /// Dormant O1B history pointer. O2S keeps the column for compatibility while a database check requires NULL.
  currentReservationId String?           @unique(map: "CartItem_currentReservationId_key") @db.Uuid
  amount               Int
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cart                 Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartItem_cartId_fkey")
  product              Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "CartItem_productId_fkey")
  currentReservation   CartReservation?  @relation("CartItemCurrentReservation", fields: [currentReservationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CartItem_currentReservationId_fkey")
  reservations         CartReservation[] @relation("CartItemReservationHistory")

  @@unique([cartId, productId], map: "CartItem_cartId_productId_key")
  @@index([cartId], map: "CartItem_cartId_idx")
  @@index([productId], map: "CartItem_productId_idx")
}

model CartReservation {
  id         String                @id(map: "CartReservation_pkey") @default(uuid()) @db.Uuid
  cartId     String                @db.Uuid
  cartItemId String?               @db.Uuid
  productId  String                @db.Uuid
  amount     Int
  /// Historical only after O2S. A database check rejects future ACTIVE rows.
  status     CartReservationStatus @default(EXPIRED)
  reservedAt DateTime
  expiresAt  DateTime
  releasedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  cart       Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartReservation_cartId_fkey")
  cartItem   CartItem?             @relation("CartItemReservationHistory", fields: [cartItemId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CartReservation_cartItemId_fkey")
  currentFor CartItem?             @relation("CartItemCurrentReservation")
  product    Product               @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "CartReservation_productId_fkey")
  orderId    String?               @db.Uuid
  order      Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "CartReservation_orderId_fkey")

  @@index([cartId, status, expiresAt], map: "CartReservation_cartId_status_expiresAt_idx")
  @@index([cartItemId, reservedAt], map: "CartReservation_cartItemId_reservedAt_idx")
  @@index([productId, status, expiresAt], map: "CartReservation_productId_status_expiresAt_idx")
  @@index([orderId], map: "CartReservation_orderId_idx")
}

model Order {
  id                       String                      @id(map: "Order_pkey") @default(uuid()) @db.Uuid
  userId                   String?                     @db.Uuid
  cartId                   String                      @db.Uuid
  idempotencyKey           String                      @db.VarChar(128)
  requestHash              Bytes
  status                   OrderStatus
  paymentMethod            PaymentMethod
  paymentState             PaymentState
  providerPaymentReference String?                     @unique(map: "Order_providerPaymentReference_key") @db.VarChar(255)
  currency                 String                      @db.VarChar(3)
  itemSubtotalMinor        Int
  discountKind             DiscountKind                @default(NONE)
  discountBasisPoints      Int                         @default(0)
  discountMinor            Int                         @default(0)
  discountPolicyVersion    String                      @default("no-discount-v1") @db.VarChar(64)
  shippingMinor            Int
  totalMinor               Int
  paymentAttemptId         String?                     @unique(map: "Order_paymentAttemptId_key") @db.Uuid
  fullName                 String                      @db.VarChar(200)
  phoneNumber              String                      @db.VarChar(32)
  city                     String                      @db.VarChar(120)
  shippingAddress          String                      @db.VarChar(500)
  placedAt                 DateTime
  paidAt                   DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  user                     User?                       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Order_userId_fkey")
  cart                     Cart                        @relation(fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Order_cartId_fkey")
  items                    OrderItem[]
  reservations             CartReservation[]
  paymentAttempt           PaymentAttempt?             @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Order_paymentAttemptId_fkey")
  paymentAllocation        PaymentAllocation?
  consumedDiscountClaim    FirstPurchaseDiscountClaim? @relation("ConsumedDiscountOrder")

  @@unique([userId, idempotencyKey], map: "Order_userId_idempotencyKey_key")
  @@index([userId, placedAt, id], map: "Order_userId_placedAt_id_idx")
  @@index([status, placedAt], map: "Order_status_placedAt_idx")
}

model CheckoutDraft {
  id                       String                 @id(map: "CheckoutDraft_pkey") @default(uuid()) @db.Uuid
  cartId                   String                 @unique(map: "CheckoutDraft_cartId_key") @db.Uuid
  userId                   String?                @db.Uuid
  guestCapabilityDigest    Bytes?                 @unique(map: "CheckoutDraft_guestCapabilityDigest_key")
  guestCapabilityExpiresAt DateTime?              @db.Timestamptz(3)
  status                   CheckoutDraftStatus    @default(PRE_PAYMENT)
  paymentMethod            PaymentMethod
  email                    String                 @db.VarChar(320)
  fullName                 String                 @db.VarChar(200)
  phoneNumber              String                 @db.VarChar(32)
  countryCode              String                 @db.Char(2)
  city                     String                 @db.VarChar(120)
  street                   String                 @db.VarChar(200)
  postalCode               String?                @db.VarChar(32)
  administrativeArea       String?                @db.VarChar(120)
  houseNumber              String?                @db.VarChar(32)
  apartmentUnit            String?                @db.VarChar(64)
  floor                    String?                @db.VarChar(32)
  additionalInfo           String?                @db.VarChar(500)
  version                  Int                    @default(1)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(3)
  cart                     Cart                   @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CheckoutDraft_cartId_fkey")
  user                     User?                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CheckoutDraft_userId_fkey")
  requests                 CheckoutDraftRequest[]
  paymentAttempts          PaymentAttempt[]

  @@index([userId, status, updatedAt], map: "CheckoutDraft_userId_status_updatedAt_idx")
  @@index([guestCapabilityExpiresAt], map: "CheckoutDraft_guestCapabilityExpiresAt_idx")
}

model PaymentAttempt {
  id                       String                      @id(map: "PaymentAttempt_pkey") @default(uuid()) @db.Uuid
  checkoutDraftId          String                      @db.Uuid
  checkoutDraftVersion     Int
  userId                   String?                     @db.Uuid
  idempotencyKey           String                      @db.VarChar(128)
  requestHash              Bytes
  status                   PaymentAttemptStatus        @default(PREPARED)
  currency                 String                      @db.Char(3)
  itemSubtotalMinor        Int
  discountKind             DiscountKind
  discountBasisPoints      Int
  discountMinor            Int
  discountPolicyVersion    String                      @db.VarChar(64)
  shippingMinor            Int
  totalMinor               Int
  quotedAt                 DateTime                    @db.Timestamptz(3)
  snapshotSealedAt         DateTime?                   @db.Timestamptz(3)
  email                    String                      @db.VarChar(320)
  fullName                 String                      @db.VarChar(200)
  phoneNumber              String                      @db.VarChar(32)
  countryCode              String                      @db.Char(2)
  city                     String                      @db.VarChar(120)
  street                   String                      @db.VarChar(200)
  postalCode               String?                     @db.VarChar(32)
  administrativeArea       String?                     @db.VarChar(120)
  houseNumber              String?                     @db.VarChar(32)
  apartmentUnit            String?                     @db.VarChar(64)
  floor                    String?                     @db.VarChar(32)
  additionalInfo           String?                     @db.VarChar(500)
  providerPaymentReference String?                     @unique(map: "PaymentAttempt_providerPaymentReference_key") @db.VarChar(255)
  providerSessionId        String?                     @unique(map: "PaymentAttempt_providerSessionId_key") @db.VarChar(255)
  providerSessionExpiresAt DateTime?                   @db.Timestamptz(3)
  pendingAt                DateTime?                   @db.Timestamptz(3)
  reconciliationRequiredAt DateTime?                   @db.Timestamptz(3)
  succeededAt              DateTime?                   @db.Timestamptz(3)
  definitivelyFailedAt     DateTime?                   @db.Timestamptz(3)
  cancelledAt              DateTime?                   @db.Timestamptz(3)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @db.Timestamptz(3)
  checkoutDraft            CheckoutDraft               @relation(fields: [checkoutDraftId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "PaymentAttempt_checkoutDraftId_fkey")
  user                     User?                       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "PaymentAttempt_userId_fkey")
  firstPurchaseClaim       FirstPurchaseDiscountClaim?
  order                    Order?
  items                    PaymentAttemptItem[]
  allocation               PaymentAllocation?
  stripeWebhookReceipts    StripeWebhookReceipt[]

  @@unique([checkoutDraftId, idempotencyKey], map: "PaymentAttempt_draftId_idempotencyKey_key")
  @@unique([id, userId], map: "PaymentAttempt_id_userId_key")
  @@index([userId, status, createdAt], map: "PaymentAttempt_userId_status_createdAt_idx")
  @@index([status, updatedAt], map: "PaymentAttempt_status_updatedAt_idx")
}

model PaymentAllocation {
  id                       String                          @id(map: "PaymentAllocation_pkey") @default(uuid()) @db.Uuid
  paymentAttemptId         String                          @unique(map: "PaymentAllocation_paymentAttemptId_key") @db.Uuid
  orderId                  String                          @unique(map: "PaymentAllocation_orderId_key") @db.Uuid
  providerPaymentReference String                          @unique(map: "PaymentAllocation_providerPaymentReference_key") @db.VarChar(255)
  status                   PaymentAllocationStatus         @default(ALLOCATED)
  authorizedAt             DateTime                        @db.Timestamptz(3)
  captureRequestedAt       DateTime?                       @db.Timestamptz(3)
  capturedAt               DateTime?                       @db.Timestamptz(3)
  releasedAt               DateTime?                       @db.Timestamptz(3)
  releaseReason            PaymentAllocationReleaseReason?
  createdAt                DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                        @updatedAt @db.Timestamptz(3)
  paymentAttempt           PaymentAttempt                  @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "PaymentAllocation_paymentAttemptId_fkey")
  order                    Order                           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "PaymentAllocation_orderId_fkey")

  @@index([status, updatedAt], map: "PaymentAllocation_status_updatedAt_idx")
}

model StripeWebhookReceipt {
  providerEventId   String                   @id(map: "StripeWebhookReceipt_pkey") @db.VarChar(255)
  paymentAttemptId  String?                  @db.Uuid
  providerObjectId  String                   @db.VarChar(255)
  eventType         String                   @db.VarChar(120)
  livemode          Boolean
  payloadHash       Bytes
  providerCreatedAt DateTime                 @db.Timestamptz(3)
  disposition       StripeWebhookDisposition
  receivedAt        DateTime                 @db.Timestamptz(3)
  processedAt       DateTime                 @db.Timestamptz(3)
  paymentAttempt    PaymentAttempt?          @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "StripeWebhookReceipt_paymentAttemptId_fkey")

  @@index([paymentAttemptId, providerCreatedAt], map: "StripeWebhookReceipt_attemptId_createdAt_idx")
  @@index([eventType, providerCreatedAt], map: "StripeWebhookReceipt_type_createdAt_idx")
}

model PaymentAttemptItem {
  id               String         @id(map: "PaymentAttemptItem_pkey") @default(uuid()) @db.Uuid
  paymentAttemptId String         @db.Uuid
  productId        String         @db.Uuid
  productSlug      String
  productName      String
  priceQualifier   String         @db.VarChar(64)
  saleKind         SaleKind
  amountUnit       AmountUnit
  priceMinor       Int
  priceBasisAmount Int
  amount           Int
  lineTotalMinor   Int
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "PaymentAttemptItem_paymentAttemptId_fkey")
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "PaymentAttemptItem_productId_fkey")

  @@unique([paymentAttemptId, productId], map: "PaymentAttemptItem_attemptId_productId_key")
  @@index([productId], map: "PaymentAttemptItem_productId_idx")
}

model FirstPurchaseDiscountClaim {
  id               String                      @id(map: "FirstPurchaseDiscountClaim_pkey") @default(uuid()) @db.Uuid
  userId           String                      @db.Uuid
  paymentAttemptId String                      @unique(map: "FirstPurchaseDiscountClaim_paymentAttemptId_key") @db.Uuid
  status           DiscountClaimStatus         @default(CLAIMED)
  heldAt           DateTime                    @db.Timestamptz(3)
  consumedAt       DateTime?                   @db.Timestamptz(3)
  consumedOrderId  String?                     @unique(map: "FirstPurchaseDiscountClaim_consumedOrderId_key") @db.Uuid
  releasedAt       DateTime?                   @db.Timestamptz(3)
  releaseReason    DiscountClaimReleaseReason?
  createdAt        DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @db.Timestamptz(3)
  user             User                        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "FirstPurchaseDiscountClaim_userId_fkey")
  paymentAttempt   PaymentAttempt              @relation(fields: [paymentAttemptId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade, map: "FirstPurchaseDiscountClaim_attempt_user_fkey")
  consumedOrder    Order?                      @relation("ConsumedDiscountOrder", fields: [consumedOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "FirstPurchaseDiscountClaim_consumedOrderId_fkey")

  @@unique([paymentAttemptId, userId], map: "FirstPurchaseDiscountClaim_attemptId_userId_key")
  @@index([userId, status, heldAt], map: "FirstPurchaseDiscountClaim_userId_status_heldAt_idx")
}

model CheckoutDraftRequest {
  id               String        @id(map: "CheckoutDraftRequest_pkey") @default(uuid()) @db.Uuid
  checkoutDraftId  String        @db.Uuid
  idempotencyKey   String        @db.VarChar(128)
  requestHash      Bytes
  responseSnapshot Json          @db.JsonB
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  checkoutDraft    CheckoutDraft @relation(fields: [checkoutDraftId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CheckoutDraftRequest_checkoutDraftId_fkey")

  @@unique([checkoutDraftId, idempotencyKey], map: "CheckoutDraftRequest_draftId_idempotencyKey_key")
  @@index([createdAt], map: "CheckoutDraftRequest_createdAt_idx")
}

model OrderItem {
  id               String     @id(map: "OrderItem_pkey") @default(uuid()) @db.Uuid
  orderId          String     @db.Uuid
  productId        String     @db.Uuid
  productSlug      String
  productName      String
  priceQualifier   String     @db.VarChar(64)
  saleKind         SaleKind
  amountUnit       AmountUnit
  priceMinor       Int
  priceBasisAmount Int
  amount           Int
  lineTotalMinor   Int
  createdAt        DateTime   @default(now())
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderItem_orderId_fkey")
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "OrderItem_productId_fkey")

  @@unique([orderId, productId], map: "OrderItem_orderId_productId_key")
  @@index([productId], map: "OrderItem_productId_idx")
}
