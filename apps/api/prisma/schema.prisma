generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CartReservationStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONSUMED
}

enum OrderStatus {
  PLACED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  STRIPE_DEBIT_CARD
  CASH_ON_DELIVERY
}

enum PaymentState {
  PENDING
  PAID
  DUE_ON_DELIVERY
  FAILED
  CANCELLED
}

enum SaleKind {
  WEIGHT
  PACKAGE
  KIT
}

enum AmountUnit {
  MILLIGRAM
  EACH
}

model User {
  id                 String              @id(map: "User_pkey") @default(uuid()) @db.Uuid
  email              String              @db.VarChar(320)
  normalizedEmail    String              @unique(map: "User_normalizedEmail_key") @db.VarChar(320)
  role               UserRole            @default(CUSTOMER)
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  passwordCredential PasswordCredential?
  authSessions       AuthSession[]
  orders             Order[]
}

model PasswordCredential {
  userId       String   @id(map: "PasswordCredential_pkey") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PasswordCredential_userId_fkey")
  passwordHash String   @db.VarChar(255)
  algorithm    String   @db.VarChar(16)
  version      Int      @db.SmallInt
  memoryCost   Int
  timeCost     Int      @db.SmallInt
  parallelism  Int      @db.SmallInt
  hashLength   Int      @db.SmallInt
  saltLength   Int      @db.SmallInt
  changedAt    DateTime @default(now())
}

model AuthSession {
  id                         String    @id(map: "AuthSession_pkey") @default(uuid()) @db.Uuid
  tokenHash                  Bytes     @unique(map: "AuthSession_tokenHash_key")
  userId                     String    @db.Uuid
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AuthSession_userId_fkey")
  roleAtIssue                UserRole
  credentialChangedAtAtIssue DateTime
  issuedAt                   DateTime  @default(now())
  lastSeenAt                 DateTime
  expiresAt                  DateTime
  revokedAt                  DateTime?

  @@index([userId, revokedAt, expiresAt, lastSeenAt], map: "AuthSession_userId_active_idx")
  @@index([expiresAt], map: "AuthSession_expiresAt_idx")
}

model Category {
  id           String    @id(map: "Category_pkey") @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique(map: "Category_slug_key")
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([displayOrder, name], map: "Category_displayOrder_name_idx")
}

model Product {
  id                 String            @id(map: "Product_pkey") @default(uuid()) @db.Uuid
  name               String
  slug               String            @unique(map: "Product_slug_key")
  teaser             String
  description        String
  priceMinor         Int
  priceQualifier     String            @db.VarChar(64)
  currency           String            @default("USD") @db.VarChar(3)
  saleKind           SaleKind
  amountUnit         AmountUnit
  priceBasisAmount   Int
  minimumOrderAmount Int
  orderStepAmount    Int
  maximumOrderAmount Int?
  stockAmount        Int               @default(0)
  packageNetWeightMg Int?
  kitYieldVolumeMl   Int?
  isActive           Boolean           @default(true)
  activeFrom         DateTime?         @db.Timestamptz(3)
  activeUntil        DateTime?         @db.Timestamptz(3)
  imagePath          String            @db.VarChar(255)
  specifications     Json              @db.JsonB
  categoryId         String            @db.Uuid
  category           Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Product_categoryId_fkey")
  cartItems          CartItem[]
  cartReservations   CartReservation[]
  orderItems         OrderItem[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([categoryId, isActive], map: "Product_categoryId_isActive_idx")
  @@index([isActive, priceMinor], map: "Product_isActive_priceMinor_idx")
  @@index([name], map: "Product_name_idx")
}

model Cart {
  id           String            @id(map: "Cart_pkey") @default(uuid()) @db.Uuid
  tokenDigest  Bytes             @unique(map: "Cart_tokenDigest_key")
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        CartItem[]
  reservations CartReservation[]
  order        Order?

  @@index([expiresAt], map: "Cart_expiresAt_idx")
}

model CartItem {
  id                   String            @id(map: "CartItem_pkey") @default(uuid()) @db.Uuid
  cartId               String            @db.Uuid
  productId            String            @db.Uuid
  /// Dormant O1B history pointer. O2S keeps the column for compatibility while a database check requires NULL.
  currentReservationId String?           @unique(map: "CartItem_currentReservationId_key") @db.Uuid
  amount               Int
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cart                 Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartItem_cartId_fkey")
  product              Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "CartItem_productId_fkey")
  currentReservation   CartReservation?  @relation("CartItemCurrentReservation", fields: [currentReservationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CartItem_currentReservationId_fkey")
  reservations         CartReservation[] @relation("CartItemReservationHistory")

  @@unique([cartId, productId], map: "CartItem_cartId_productId_key")
  @@index([cartId], map: "CartItem_cartId_idx")
  @@index([productId], map: "CartItem_productId_idx")
}

model CartReservation {
  id         String                @id(map: "CartReservation_pkey") @default(uuid()) @db.Uuid
  cartId     String                @db.Uuid
  cartItemId String?               @db.Uuid
  productId  String                @db.Uuid
  amount     Int
  /// Historical only after O2S. A database check rejects future ACTIVE rows.
  status     CartReservationStatus @default(EXPIRED)
  reservedAt DateTime
  expiresAt  DateTime
  releasedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  cart       Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartReservation_cartId_fkey")
  cartItem   CartItem?             @relation("CartItemReservationHistory", fields: [cartItemId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CartReservation_cartItemId_fkey")
  currentFor CartItem?             @relation("CartItemCurrentReservation")
  product    Product               @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "CartReservation_productId_fkey")
  orderId    String?               @db.Uuid
  order      Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "CartReservation_orderId_fkey")

  @@index([cartId, status, expiresAt], map: "CartReservation_cartId_status_expiresAt_idx")
  @@index([cartItemId, reservedAt], map: "CartReservation_cartItemId_reservedAt_idx")
  @@index([productId, status, expiresAt], map: "CartReservation_productId_status_expiresAt_idx")
  @@index([orderId], map: "CartReservation_orderId_idx")
}

model Order {
  id                       String            @id(map: "Order_pkey") @default(uuid()) @db.Uuid
  userId                   String            @db.Uuid
  cartId                   String            @unique(map: "Order_cartId_key") @db.Uuid
  idempotencyKey           String            @db.VarChar(128)
  requestHash              Bytes
  status                   OrderStatus
  paymentMethod            PaymentMethod
  paymentState             PaymentState
  providerPaymentReference String?           @unique(map: "Order_providerPaymentReference_key") @db.VarChar(255)
  currency                 String            @db.VarChar(3)
  itemSubtotalMinor        Int
  shippingMinor            Int
  totalMinor               Int
  fullName                 String            @db.VarChar(200)
  phoneNumber              String            @db.VarChar(32)
  city                     String            @db.VarChar(120)
  shippingAddress          String            @db.VarChar(500)
  placedAt                 DateTime
  paidAt                   DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  user                     User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Order_userId_fkey")
  cart                     Cart              @relation(fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Order_cartId_fkey")
  items                    OrderItem[]
  reservations             CartReservation[]

  @@unique([userId, idempotencyKey], map: "Order_userId_idempotencyKey_key")
  @@index([userId, placedAt, id], map: "Order_userId_placedAt_id_idx")
  @@index([status, placedAt], map: "Order_status_placedAt_idx")
}

model OrderItem {
  id               String     @id(map: "OrderItem_pkey") @default(uuid()) @db.Uuid
  orderId          String     @db.Uuid
  productId        String     @db.Uuid
  productSlug      String
  productName      String
  priceQualifier   String     @db.VarChar(64)
  saleKind         SaleKind
  amountUnit       AmountUnit
  priceMinor       Int
  priceBasisAmount Int
  amount           Int
  lineTotalMinor   Int
  createdAt        DateTime   @default(now())
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderItem_orderId_fkey")
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "OrderItem_productId_fkey")

  @@unique([orderId, productId], map: "OrderItem_orderId_productId_key")
  @@index([productId], map: "OrderItem_productId_idx")
}
