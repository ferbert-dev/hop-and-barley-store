DATABASE_URL=postgresql://hopbarley:hopbarley@localhost:5432/hopbarley?schema=public
PORT=3001
PRODUCT_ASSET_STORAGE_PATH=.local/product-assets
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CART_COOKIE_MODE=local-http
CART_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CART_CSRF_KEYRING=cart-v1:replace-with-64-lowercase-hex-characters
REGISTRATION_ENABLED=true
REGISTRATION_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
STRIPE_PAYMENTS_ENABLED=false
STRIPE_API_TIMEOUT_MS=10000
# Server-only Sandbox values. Keep empty while disabled and never commit values.
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout?payment=return
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/checkout?payment=cancelled
