# Copy with deploy/generate-env.sh. Never put the generated file in Git.
COMPOSE_PROJECT_NAME=hopbarley
RELEASE_ID=0123456789abcdef0123456789abcdef01234567

# Release images are built off the VM and tagged with the exact Git SHA.
WEB_IMAGE=hopbarley/web:0123456789abcdef0123456789abcdef01234567
API_IMAGE=hopbarley/api:0123456789abcdef0123456789abcdef01234567
MIGRATE_IMAGE=hopbarley/migrate:0123456789abcdef0123456789abcdef01234567

# Resolve and record exact digests before deployment when pulling these images.
POSTGRES_IMAGE=postgres:17.6-alpine
CADDY_IMAGE=caddy:2.10.2-alpine

POSTGRES_DB=hopbarley
POSTGRES_USER=hopbarley
POSTGRES_PASSWORD=generated-server-side-64-lowercase-hex
DATABASE_URL=postgresql://hopbarley:generated-server-side-64-lowercase-hex@postgres:5432/hopbarley?schema=public
AUTH_CSRF_KEYRING=v1:generated-server-side-64-lowercase-hex
CART_CSRF_KEYRING=v1:generated-server-side-64-lowercase-hex
